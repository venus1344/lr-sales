generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model abilities {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name         String
  label        String?
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  ability_role ability_role[]
}

model ability_role {
  created_by BigInt    @db.UnsignedBigInt
  role_id    BigInt    @db.UnsignedBigInt
  ability_id BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  abilities  abilities @relation(fields: [ability_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ability_role_ability_id_foreign")
  users      users     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "ability_role_created_by_foreign")
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ability_role_role_id_foreign")

  @@id([role_id, ability_id])
  @@index([ability_id], map: "ability_role_ability_id_foreign")
  @@index([created_by], map: "ability_role_created_by_foreign")
}

model currencies {
  id                                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                         BigInt?   @db.UnsignedBigInt
  updated_by                         BigInt?   @db.UnsignedBigInt
  code                               String    @db.Char(3)
  name                               String    @db.VarChar(60)
  rate                               Float     @default(1.00)
  active                             Boolean   @default(true)
  created_at                         DateTime? @db.Timestamp(0)
  updated_at                         DateTime? @db.Timestamp(0)
  users_currencies_created_byTousers users?    @relation("currencies_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currencies_created_by_foreign")
  users_currencies_updated_byTousers users?    @relation("currencies_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "currencies_updated_by_foreign")

  @@index([created_by], map: "currencies_created_by_foreign")
  @@index([updated_by], map: "currencies_updated_by_foreign")
}

model customers {
  id                                BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                        BigInt?              @db.UnsignedBigInt
  updated_by                        BigInt?              @db.UnsignedBigInt
  name                              String
  postal_code                       String?
  postal_address                    String?
  location                          String?
  contact                           String?
  tin                               String?              @db.VarChar(20)
  vrn                               String?              @db.VarChar(20)
  status                            Boolean              @default(true)
  created_at                        DateTime?            @db.Timestamp(0)
  updated_at                        DateTime?            @db.Timestamp(0)
  users_customers_created_byTousers users?               @relation("customers_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_created_by_foreign")
  users_customers_updated_byTousers users?               @relation("customers_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "customers_updated_by_foreign")
  internet_customers                internet_customers[]
  internet_invoices                 internet_invoices[]
  projects                          projects[]

  @@index([created_by], map: "customers_created_by_foreign")
  @@index([updated_by], map: "customers_updated_by_foreign")
}

model delivery_note_items {
  id                                          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                  BigInt?         @db.UnsignedBigInt
  updated_by                                  BigInt?         @db.UnsignedBigInt
  dnote_id                                    BigInt?         @db.UnsignedBigInt
  item_id                                     BigInt          @db.UnsignedBigInt
  description                                 String          @db.Text
  unit_measure                                String?         @db.VarChar(12)
  quantity                                    Int
  serial_no                                   String?
  created_at                                  DateTime?       @db.Timestamp(0)
  updated_at                                  DateTime?       @db.Timestamp(0)
  users_delivery_note_items_created_byTousers users?          @relation("delivery_note_items_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_note_items_created_by_foreign")
  delivery_notes                              delivery_notes? @relation(fields: [dnote_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_note_items_dnote_id_foreign")
  items                                       items           @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_note_items_item_id_foreign")
  users_delivery_note_items_updated_byTousers users?          @relation("delivery_note_items_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_note_items_updated_by_foreign")

  @@index([created_by], map: "delivery_note_items_created_by_foreign")
  @@index([dnote_id], map: "delivery_note_items_dnote_id_foreign")
  @@index([item_id], map: "delivery_note_items_item_id_foreign")
  @@index([updated_by], map: "delivery_note_items_updated_by_foreign")
}

model delivery_notes {
  id                                     BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                             BigInt?               @db.UnsignedBigInt
  updated_by                             BigInt?               @db.UnsignedBigInt
  invoice_id                             BigInt?               @db.UnsignedBigInt
  date                                   DateTime              @db.Date
  name                                   String
  postal                                 String?
  location                               String?
  contact                                String?
  tin                                    String?               @db.VarChar(20)
  vrn                                    String?               @db.VarChar(20)
  created_at                             DateTime?             @db.Timestamp(0)
  updated_at                             DateTime?             @db.Timestamp(0)
  delivery_note_items                    delivery_note_items[]
  users_delivery_notes_created_byTousers users?                @relation("delivery_notes_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_notes_created_by_foreign")
  invoices                               invoices?             @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_notes_invoice_id_foreign")
  users_delivery_notes_updated_byTousers users?                @relation("delivery_notes_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "delivery_notes_updated_by_foreign")

  @@index([created_by], map: "delivery_notes_created_by_foreign")
  @@index([invoice_id], map: "delivery_notes_invoice_id_foreign")
  @@index([updated_by], map: "delivery_notes_updated_by_foreign")
}

model expense_accounts {
  id                                       BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                               BigInt     @db.UnsignedBigInt
  updated_by                               BigInt?    @db.UnsignedBigInt
  name                                     String     @db.VarChar(200)
  description                              String     @db.VarChar(300)
  active                                   Boolean    @default(true)
  created_at                               DateTime?  @db.Timestamp(0)
  updated_at                               DateTime?  @db.Timestamp(0)
  users_expense_accounts_created_byTousers users      @relation("expense_accounts_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_accounts_created_by_foreign")
  users_expense_accounts_updated_byTousers users?     @relation("expense_accounts_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expense_accounts_updated_by_foreign")
  expenses                                 expenses[]

  @@index([created_by], map: "expense_accounts_created_by_foreign")
  @@index([updated_by], map: "expense_accounts_updated_by_foreign")
}

model expenses {
  id                                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                         BigInt           @db.UnsignedBigInt
  updated_by                         BigInt?          @db.UnsignedBigInt
  requested_by                       BigInt           @db.UnsignedBigInt
  expense_account_id                 BigInt           @db.UnsignedBigInt
  income_account_id                  BigInt           @db.UnsignedBigInt
  project_id                         BigInt?          @db.UnsignedBigInt
  receipt_number                     String?          @db.VarChar(50)
  amount                             Decimal          @db.Decimal(25, 2)
  narration                          String           @db.Text
  receipt                            String?
  created_at                         DateTime?        @db.Timestamp(0)
  updated_at                         DateTime?        @db.Timestamp(0)
  users_expenses_created_byTousers   users            @relation("expenses_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_created_by_foreign")
  expense_accounts                   expense_accounts @relation(fields: [expense_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_expense_account_id_foreign")
  income_accounts                    income_accounts  @relation(fields: [income_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_income_account_id_foreign")
  projects                           projects?        @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_project_id_foreign")
  users_expenses_requested_byTousers users            @relation("expenses_requested_byTousers", fields: [requested_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_requested_by_foreign")
  users_expenses_updated_byTousers   users?           @relation("expenses_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_updated_by_foreign")

  @@index([created_by], map: "expenses_created_by_foreign")
  @@index([expense_account_id], map: "expenses_expense_account_id_foreign")
  @@index([income_account_id], map: "expenses_income_account_id_foreign")
  @@index([project_id], map: "expenses_project_id_foreign")
  @@index([requested_by], map: "expenses_requested_by_foreign")
  @@index([updated_by], map: "expenses_updated_by_foreign")
}

model income_accounts {
  id                                      BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                              BigInt     @db.UnsignedBigInt
  updated_by                              BigInt?    @db.UnsignedBigInt
  name                                    String     @db.VarChar(200)
  description                             String     @db.VarChar(300)
  active                                  Boolean    @default(true)
  created_at                              DateTime?  @db.Timestamp(0)
  updated_at                              DateTime?  @db.Timestamp(0)
  expenses                                expenses[]
  users_income_accounts_created_byTousers users      @relation("income_accounts_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "income_accounts_created_by_foreign")
  users_income_accounts_updated_byTousers users?     @relation("income_accounts_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "income_accounts_updated_by_foreign")

  @@index([created_by], map: "income_accounts_created_by_foreign")
  @@index([updated_by], map: "income_accounts_updated_by_foreign")
}

model internet_customers {
  id                                         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                 BigInt?   @db.UnsignedBigInt
  updated_by                                 BigInt?   @db.UnsignedBigInt
  customer_id                                BigInt    @db.UnsignedBigInt
  package_id                                 BigInt?   @db.UnsignedBigInt
  started                                    DateTime? @db.Date
  status                                     Boolean   @default(true)
  created_at                                 DateTime? @db.Timestamp(0)
  updated_at                                 DateTime? @db.Timestamp(0)
  users_internet_customers_created_byTousers users?    @relation("internet_customers_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_customers_created_by_foreign")
  customers                                  customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_customers_customer_id_foreign")
  packages                                   packages? @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_customers_package_id_foreign")
  users_internet_customers_updated_byTousers users?    @relation("internet_customers_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_customers_updated_by_foreign")

  @@index([created_by], map: "internet_customers_created_by_foreign")
  @@index([customer_id], map: "internet_customers_customer_id_foreign")
  @@index([package_id], map: "internet_customers_package_id_foreign")
  @@index([updated_by], map: "internet_customers_updated_by_foreign")
}

model internet_invoice_packages {
  id                                                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                        BigInt?            @db.UnsignedBigInt
  updated_by                                        BigInt?            @db.UnsignedBigInt
  invoice_id                                        BigInt?            @db.UnsignedBigInt
  package_id                                        BigInt             @db.UnsignedBigInt
  description                                       String             @db.Text
  quantity                                          Int
  unit_price                                        Float
  created_at                                        DateTime?          @db.Timestamp(0)
  updated_at                                        DateTime?          @db.Timestamp(0)
  users_internet_invoice_packages_created_byTousers users?             @relation("internet_invoice_packages_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoice_packages_created_by_foreign")
  internet_invoices                                 internet_invoices? @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoice_packages_invoice_id_foreign")
  packages                                          packages           @relation(fields: [package_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoice_packages_package_id_foreign")
  users_internet_invoice_packages_updated_byTousers users?             @relation("internet_invoice_packages_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoice_packages_updated_by_foreign")

  @@index([created_by], map: "internet_invoice_packages_created_by_foreign")
  @@index([invoice_id], map: "internet_invoice_packages_invoice_id_foreign")
  @@index([package_id], map: "internet_invoice_packages_package_id_foreign")
  @@index([updated_by], map: "internet_invoice_packages_updated_by_foreign")
}

model internet_invoices {
  id                                        BigInt                      @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                BigInt?                     @db.UnsignedBigInt
  updated_by                                BigInt?                     @db.UnsignedBigInt
  customer_id                               BigInt?                     @db.UnsignedBigInt
  reference                                 String
  date                                      DateTime?                   @db.Date
  effective_from                            DateTime?                   @db.Date
  effective_to                              DateTime?                   @db.Date
  vat                                       Float?
  currency                                  String?                     @default("TZS") @db.VarChar(5)
  status                                    Boolean                     @default(true)
  created_at                                DateTime?                   @db.Timestamp(0)
  updated_at                                DateTime?                   @db.Timestamp(0)
  internet_invoice_packages                 internet_invoice_packages[]
  users_internet_invoices_created_byTousers users?                      @relation("internet_invoices_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoices_created_by_foreign")
  customers                                 customers?                  @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoices_customer_id_foreign")
  users_internet_invoices_updated_byTousers users?                      @relation("internet_invoices_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "internet_invoices_updated_by_foreign")

  @@index([created_by], map: "internet_invoices_created_by_foreign")
  @@index([customer_id], map: "internet_invoices_customer_id_foreign")
  @@index([updated_by], map: "internet_invoices_updated_by_foreign")
}

model invoice_items {
  id                                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                            BigInt?   @db.UnsignedBigInt
  updated_by                            BigInt?   @db.UnsignedBigInt
  invoice_id                            BigInt    @db.UnsignedBigInt
  item_id                               BigInt    @db.UnsignedBigInt
  specification                         String    @db.Text
  unit_measure                          String?   @db.VarChar(12)
  quantity                              Int
  price                                 Decimal   @db.Decimal(25, 2)
  created_at                            DateTime? @db.Timestamp(0)
  updated_at                            DateTime? @db.Timestamp(0)
  users_invoice_items_created_byTousers users?    @relation("invoice_items_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_created_by_foreign")
  invoices                              invoices  @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_invoice_id_foreign")
  items                                 items     @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_item_id_foreign")
  users_invoice_items_updated_byTousers users?    @relation("invoice_items_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoice_items_updated_by_foreign")

  @@index([created_by], map: "invoice_items_created_by_foreign")
  @@index([invoice_id], map: "invoice_items_invoice_id_foreign")
  @@index([item_id], map: "invoice_items_item_id_foreign")
  @@index([updated_by], map: "invoice_items_updated_by_foreign")
}

model invoices {
  id                               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                       BigInt?          @db.UnsignedBigInt
  updated_by                       BigInt?          @db.UnsignedBigInt
  proforma_id                      BigInt?          @db.UnsignedBigInt
  name                             String
  postal                           String?
  location                         String?
  contact                          String?
  date                             DateTime         @db.Date
  notes                            String           @db.VarChar(15)
  for                              String
  advance                          Decimal          @db.Decimal(25, 2)
  currency                         String           @db.VarChar(10)
  exchange_rate                    Float            @default(1.00)
  labor_charge                     Decimal          @default(0.00) @db.Decimal(25, 2)
  withholding_tax                  Decimal          @default(0.00) @db.Decimal(4, 2)
  vat                              Decimal          @default(0.00) @db.Decimal(4, 2)
  tin                              String?          @db.VarChar(20)
  vrn                              String?          @db.VarChar(20)
  discount                         Float            @default(0) @db.Float
  created_at                       DateTime?        @db.Timestamp(0)
  updated_at                       DateTime?        @db.Timestamp(0)
  delivery_notes                   delivery_notes[]
  invoice_items                    invoice_items[]
  users_invoices_created_byTousers users?           @relation("invoices_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_created_by_foreign")
  proformas                        proformas?       @relation(fields: [proforma_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_proforma_id_foreign")
  users_invoices_updated_byTousers users?           @relation("invoices_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "invoices_updated_by_foreign")

  @@index([created_by], map: "invoices_created_by_foreign")
  @@index([proforma_id], map: "invoices_proforma_id_foreign")
  @@index([updated_by], map: "invoices_updated_by_foreign")
}

model item_categories {
  id                                      BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                              BigInt    @db.UnsignedBigInt
  updated_by                              BigInt?   @db.UnsignedBigInt
  name                                    String    @db.VarChar(100)
  description                             String?   @db.Text
  active                                  Boolean   @default(true)
  created_at                              DateTime? @db.Timestamp(0)
  updated_at                              DateTime? @db.Timestamp(0)
  users_item_categories_created_byTousers users     @relation("item_categories_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_categories_created_by_foreign")
  users_item_categories_updated_byTousers users?    @relation("item_categories_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "item_categories_updated_by_foreign")
  items                                   items[]

  @@index([created_by], map: "item_categories_created_by_foreign")
  @@index([updated_by], map: "item_categories_updated_by_foreign")
}

model items {
  id                            BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                    BigInt?                      @db.UnsignedBigInt
  updated_by                    BigInt?                      @db.UnsignedBigInt
  category_id                   BigInt                       @default(1) @db.UnsignedBigInt
  name                          String                       @db.VarChar(100)
  unit_measure                  String?                      @db.VarChar(100)
  specification                 String?                      @db.Text
  price                         Decimal                      @db.Decimal(25, 2)
  active                        Boolean                      @default(true)
  created_at                    DateTime?                    @db.Timestamp(0)
  updated_at                    DateTime?                    @db.Timestamp(0)
  vat                           Boolean                      @default(true)
  delivery_note_items           delivery_note_items[]
  invoice_items                 invoice_items[]
  item_categories               item_categories              @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_category_id_foreign")
  users_items_created_byTousers users?                       @relation("items_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_created_by_foreign")
  users_items_updated_byTousers users?                       @relation("items_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "items_updated_by_foreign")
  local_purchase_order_items    local_purchase_order_items[]
  proforma_items                proforma_items[]

  @@index([category_id], map: "items_category_id_foreign")
  @@index([created_by], map: "items_created_by_foreign")
  @@index([updated_by], map: "items_updated_by_foreign")
}

model local_purchase_order_items {
  id                                                 BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                         BigInt?               @db.UnsignedBigInt
  updated_by                                         BigInt?               @db.UnsignedBigInt
  lpo_id                                             BigInt                @db.UnsignedBigInt
  item_id                                            BigInt                @db.UnsignedBigInt
  specification                                      String                @db.Text
  quantity                                           Int
  price                                              Decimal               @db.Decimal(25, 2)
  created_at                                         DateTime?             @db.Timestamp(0)
  updated_at                                         DateTime?             @db.Timestamp(0)
  users_local_purchase_order_items_created_byTousers users?                @relation("local_purchase_order_items_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "local_purchase_order_items_created_by_foreign")
  items                                              items                 @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "local_purchase_order_items_item_id_foreign")
  local_purchase_orders                              local_purchase_orders @relation(fields: [lpo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "local_purchase_order_items_lpo_id_foreign")
  users_local_purchase_order_items_updated_byTousers users?                @relation("local_purchase_order_items_updated_byTousers", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "local_purchase_order_items_updated_by_foreign")

  @@index([created_by], map: "local_purchase_order_items_created_by_foreign")
  @@index([item_id], map: "local_purchase_order_items_item_id_foreign")
  @@index([lpo_id], map: "local_purchase_order_items_lpo_id_foreign")
  @@index([updated_by], map: "local_purchase_order_items_updated_by_foreign")
}

model local_purchase_orders {
  id                                            BigInt                       @id @default(autoincrement()) @db.UnsignedBigInt
  created_by                                    BigInt?                      @db.UnsignedBigInt
  updated_by                                    BigInt?                      @db.UnsignedBigInt
  supplier_id                                   BigInt                       @db.UnsignedBigInt
  date                                          DateTime                     @db.Date
  reference_no                                  String                       @db.VarChar(15)
  currency                                      String                       @db.VarChar(100)
  for                                           String?
  proforma_referenced                           String?
