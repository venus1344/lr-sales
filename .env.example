# MySQL — local dev via `docker compose up -d` (port 3307).
# Production uses its own MySQL server; DATABASE_URL points there instead.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL="mysql://welink:CHANGE_ME@localhost:3307/welink_sales"

# Auth.js — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Deployment (docker compose -f docker-compose.prod.yml)
# Super-admin account created by the migrate/seed service on first boot.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Host port the app is published on (loopback only; your reverse proxy targets it).
APP_PORT=3000
